# --- Supabase ---

# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_).
# Find both under Project Settings -> API in the Supabase dashboard. The
# "anon" key is also labeled "publishable" on newer Supabase projects --
# either one works here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Secret. Server-side only -- never prefix with NEXT_PUBLIC_, never send to
# the browser. Bypasses Row Level Security; used for photo/document upload
# tickets, lead writes, and dashboard admin actions (creating staff users).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App configuration ---

# Used to build absolute deferred-upload links (e.g. https://example.com).
# Falls back to http://localhost:3000 in development if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The organizations.id row every public intake submission is attributed to.
# Server-side only. See the "Default Organization" row seeded by the
# redesign_leads_multitenant_schema migration -- set this to that row's id.
DEFAULT_ORG_ID=

# --- Optional: AI-assisted voice intake ---

# Secret. Server-side only. When set, the seller wizard's "speak your
# answers" steps use Claude to pull several fields out of one freeform
# description (e.g. "it's a vacant multifamily needing major repairs, I want
# to sell ASAP"). Get a key at https://console.anthropic.com/settings/keys.
# Entirely optional -- when unset, the same steps still work using built-in
# keyword matching instead of AI.
ANTHROPIC_API_KEY=
