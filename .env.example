# Supabase project URL and publishable key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret. Server-side only — never prefix with NEXT_PUBLIC_, never send to the
# browser. Used to bypass RLS for photo upload tickets and lead writes.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute deferred-upload links (e.g. https://example.com).
# Falls back to http://localhost:3000 in development if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
